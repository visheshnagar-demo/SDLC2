# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:///./identity.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production-aegis-trust-2026
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Read by the backend code (ACCESS_TOKEN_EXPIRE_MINUTES)
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Read by the backend code (JWT_ALGORITHM)
JWT_ALGORITHM=HS256
# Read by the backend code (REFRESH_TOKEN_EXPIRE_DAYS)
REFRESH_TOKEN_EXPIRE_DAYS=7
# Read by the backend code (TESTING)
TESTING=false
# Read by the backend code (UPLOAD_DIR)
UPLOAD_DIR=./uploads
