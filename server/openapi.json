{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor",
    "description": "DG Cluster Assortment Advisor Decision-Support REST API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/assortment/kpis": {
      "get": {
        "tags": [
          "Assortment KPIs"
        ],
        "summary": "Get Kpis",
        "description": "Retrieve live baseline KPI metrics for the cluster.",
        "operationId": "get_kpis_api_v1_assortment_kpis_get",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Target store cluster identifier",
              "default": "small_town_value",
              "title": "Cluster Id"
            },
            "description": "Target store cluster identifier"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KpiResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/skus": {
      "get": {
        "tags": [
          "SKU Performance"
        ],
        "summary": "Get Skus",
        "description": "Retrieve SKU catalog with velocity, efficiency metrics, and recommendation badges.",
        "operationId": "get_skus_api_v1_assortment_skus_get",
        "parameters": [
          {
            "name": "cluster_id",
            "in": "query",
            "required": false,
