                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Cluster ID or code",
              "default": "STV-CLUSTER-01",
              "title": "Cluster Id"
            },
            "description": "Cluster ID or code"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClusterKpiResponse"
