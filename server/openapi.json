{
  "openapi": "3.1.0",
  "info": {
    "title": "DG Cluster Assortment Advisor API",
    "description": "Backend decision-support API for Dollar General Snacks Assortment in Small Town Value Clusters",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/kpis/summary": {
      "get": {
        "tags": [
          "kpis"
        ],
        "summary": "Get Kpi Summary",
        "operationId": "get_kpi_summary_api_v1_kpis_summary_get",
        "parameters": [
          {
            "name": "cluster_code",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "STV-CLUSTER-04",
              "title": "Cluster Code"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/KPISummaryResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/skus": {
      "get": {
        "tags": [
          "skus"
        ],
        "summary": "Get Skus",
        "operationId": "get_skus_api_v1_skus_get",
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Category filter (e.g. Snacks)",
              "title": "Category"
            },
            "description": "Category filter (e.g. Snacks)"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Status badge filter (GROW, MAINTAIN, SWAP, REDUCE)",
              "title": "Status"
            },
            "description": "Status badge filter (GROW, MAINTAIN, SWAP, REDUCE)"
          },
          {
            "name": "is_private_brand",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Private Brand flag",
              "title": "Is Private Brand"
            },
            "description": "Filter by Private Brand flag"
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Search keyword for name or SKU number",
              "title": "Search"
            },
            "description": "Search keyword for name or SKU number"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SKUListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/scenarios": {
      "get": {
        "tags": [
          "scenarios"
        ],
        "summary": "Get Scenarios",
        "operationId": "get_scenarios_api_v1_scenarios_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/submit": {
      "post": {
        "tags": [
          "assortment"
        ],
        "summary": "Submit Assortment Plan",
        "operationId": "submit_assortment_plan_api_v1_assortment_submit_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssortmentSubmitRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssortmentSubmitResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assortment/audit-logs": {
      "get": {
        "tags": [
          "assortment"
        ],
        "summary": "Get Audit Logs",
        "operationId": "get_audit_logs_api_v1_assortment_audit_logs_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AuditLogResponse"
                  },
                  "type": "array",
                  "title": "Response Get Audit Logs Api V1 Assortment Audit Logs Get"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "summary": "Root",
        "operationId": "root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssortmentSubmitRequest": {
        "properties": {
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id",
            "default": "STV-CLUSTER-04"
          },
          "category": {
            "type": "string",
            "title": "Category",
            "default": "Snacks"
          },
          "scenario_id": {
            "type": "string",
            "title": "Scenario Id",
            "default": "balanced"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By",
            "default": "category.manager@dollargeneral.com"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          }
        },
        "type": "object",
        "title": "AssortmentSubmitRequest"
      },
      "AssortmentSubmitResponse": {
        "properties": {
          "submission_id": {
            "type": "string",
            "title": "Submission Id"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "scenario_selected": {
            "type": "string",
            "title": "Scenario Selected"
          },
          "cluster_id": {
            "type": "string",
            "title": "Cluster Id"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "submitted_by": {
            "type": "string",
            "title": "Submitted By"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time",
            "title": "Submitted At"
          },
          "sku_action_summary": {
            "$ref": "#/components/schemas/SkuActionSummary"
          },
          "guardrail_results": {
            "items": {
              "$ref": "#/components/schemas/GuardrailResult"
            },
            "type": "array",
            "title": "Guardrail Results"
          },
          "audit_trail_message": {
            "type": "string",
            "title": "Audit Trail Message"
          }
        },
        "type": "object",
        "required": [
          "submission_id",
          "status",
          "scenario_selected",
          "cluster_id",
          "category",
          "submitted_by",
          "submitted_at",
          "sku_action_summary",
          "guardrail_results",
          "audit_trail_message"
        ],
        "title": "AssortmentSubmitResponse"
