# CitiDirect Account Statement Application Environment Configuration

# Server Port
SERVER_PORT=8080

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/citidirect
SPRING_DATASOURCE_USERNAME=citidirect_user
SPRING_DATASOURCE_PASSWORD=citidirect_pass
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# JWT Authentication Secret (32+ bytes minimum)
JWT_SECRET=citi_super_secret_jwt_key_for_testing_purposes_only_32bytes_min
JWT_EXPIRATION_MS=86400000

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:4200,http://localhost:5173,http://localhost:3000

# Mail & SMTP Delivery Configuration (MailHog)
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025

# --- Auto-added at push: vars read by the code but missing above ---
# Database connection string
DATABASE_URL=sqlite:///./test.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production
