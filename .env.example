# Environment variables for local development.
# Copy to .env and adjust values:  cp .env.example .env

# Database connection string
DATABASE_URL=sqlite:////tmp/app.db
# Secret key for JWT token signing
JWT_SECRET_KEY=dev-secret-change-in-production-1234567890
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Read by the backend code (ACCESS_TOKEN_EXPIRE_MINUTES)
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Read by the backend code (MANAGER_DEFAULT_AUTHORITY_LIMIT)
MANAGER_DEFAULT_AUTHORITY_LIMIT=50000000.0
# Read by the backend code (SLA_BREACH_HOURS)
SLA_BREACH_HOURS=48.0
# Read by the backend code (SLA_WARNING_HOURS)
SLA_WARNING_HOURS=24.0
# Read by the backend code (TESTING)
TESTING=changeme
# Read by the backend code (UNDERWRITER_DEFAULT_AUTHORITY_LIMIT)
UNDERWRITER_DEFAULT_AUTHORITY_LIMIT=5000000.0
