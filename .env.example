# Server Port
PORT=8080

# Database Configuration (PostgreSQL in production, H2 in-memory in dev/test)
DATABASE_URL=jdbc:h2:mem:citidirect;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DATABASE_DRIVER=org.h2.Driver
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# JWT Authentication
JWT_SECRET_KEY=citiDirectSecretKeyForJwtSigningMustBeVeryLongAndSecure2026!
JWT_EXPIRATION_SECONDS=86400

# CORS Configuration (Comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4200,http://localhost:3000
