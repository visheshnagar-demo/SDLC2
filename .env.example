# Database configuration
SPRING_DATASOURCE_URL=jdbc:h2:mem:authdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
DATABASE_URL=jdbc:postgresql://localhost:5432/authdb

# JWT Security
JWT_SECRET_KEY=defaultSecretKeyForDevelopmentMustBeAtLeast256BitsLongSoItDoesNotFailHS256Signature123456

# Server Port
PORT=8080

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
